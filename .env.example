PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=ticklish-user
DB_PASSWORD=postgres
DB_NAME=ticklish
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
QUEUE_PRODUCER_AUTO_START=true
NODE_ENV=development
COOKIE_SECRET=your_cookie_secret_here
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=3600s
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here
RESEND_API_KEY=your_resend_api_key_here
# AWS SES (used when EMAIL_PROVIDER=aws-ses)
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# Email shared config
EMAIL_PROVIDER=resend
EMAIL_DEFAULT_FROM=noreply@example.com