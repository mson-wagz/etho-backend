{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "cli": "ts-node -r tsconfig-paths/register src/cli.ts",
    "cli-prod": "node --max-old-space-size=512 dist/cli.js",
    "cli:dev": "npm run cli --",
    "cli:prod": "npm run cli-prod --",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typeorm": "ts-node ./node_modules/typeorm/cli",
    "migration:generate": "npm run build && npm run typeorm -- migration:generate -d ./src/common/config/db.config.ts",
    "migration:run": "npm run build && npm run typeorm -- migration:run -d ./src/common/config/db.config.ts",
    "migration:revert": "npm run build && npm run typeorm -- migration:revert -d ./src/common/config/db.config.ts",
    "migration:show": "npm run build && npm run typeorm -- migration:show -d ./src/common/config/db.config.ts",
    "migration:prod:generate": "node ./node_modules/typeorm/cli migration:generate -d ./dist/common/config/db.config.js",
    "migration:prod:run": "node ./node_modules/typeorm/cli migration:run -d ./dist/common/config/db.config.js",
    "migration:prod:revert": "node ./node_modules/typeorm/cli migration:revert -d ./dist/common/config/db.config.js",
    "migration:prod:show": "node ./node_modules/typeorm/cli migration:show -d ./dist/common/config/db.config.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "seed": "ts-node -r tsconfig-paths/register src/entities/seeders/seeder.ts",
    "seed:prod": "node dist/entities/seeders/seeder.js",
    "seed:refresh": "ts-node -r tsconfig-paths/register src/entities/seeders/seeder.ts --refresh",
    "seed:prod:refresh": "node dist/entities/seeders/seeder.js --refresh"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1011.0",
    "@bull-board/api": "^6.16.4",
    "@bull-board/express": "^6.20.3",
    "@bull-board/nestjs": "^6.20.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/typeorm": "^11.0.0",
    "@types/cron": "^2.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.66.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "dotenv": "^17.2.3",
    "ioredis": "^5.8.2",
    "nest-commander": "^3.20.1",
    "nestjs-seeder": "^0.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.9.3",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-extended": "^7.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
